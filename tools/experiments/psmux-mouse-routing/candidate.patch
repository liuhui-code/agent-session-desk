+// Select one delivery channel only for an explicitly selected directory host.
+// Defaults and a failed directory load retain the pinned legacy route.
+pub(crate) fn record_bypass_for_host(
+    wheel: bool, legacy_system: bool, directory_loaded: bool, pipe_only: bool,
+) -> bool {
+    if directory_loaded && pipe_only {
+        return false;
+    }
+    wheel || legacy_system
+}
+
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn verified_directory_pipe_mode_has_no_second_record_channel() {
+        for wheel in [false, true] {
+            assert!(!super::record_bypass_for_host(wheel, true, true, true),
+                "verified modern directory still duplicated wheel={wheel}");
+        }
+    }
+    #[test]
+    fn default_and_failed_directory_keep_the_legacy_channels() {
+        // Windows 10 remains unchanged unless both opt-in and load are true.
+        assert!(super::record_bypass_for_host(false, true, false, false));
+        assert!(super::record_bypass_for_host(true, true, false, false));
+        assert!(super::record_bypass_for_host(false, true, false, true));
+        assert!(super::record_bypass_for_host(true, true, false, true));
+        assert!(super::record_bypass_for_host(false, true, true, false));
+        // A modern inbox host retains the pinned wheel-only exception.
+        assert!(!super::record_bypass_for_host(false, false, false, false));
+        assert!(super::record_bypass_for_host(true, false, false, false));
+        assert!(!super::record_bypass_for_host(false, false, false, true));
+        assert!(super::record_bypass_for_host(true, false, false, true));
+    }
+
+}
