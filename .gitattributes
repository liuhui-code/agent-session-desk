# Keep tested source bytes reproducible across Windows and Unix checkouts.
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf
*.ps1 text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
tools/ci/*.json text eol=lf
# Terminal captures are byte evidence; preserve VT CRLF and ANSI sequences.
docs/testing/results/2026-11-23-upstream-visual-comparison-evidence/frames/* -text
