--- a/internal/ui/diagnostic_keys.go
+++ b/internal/ui/diagnostic_keys.go
@@ -0,0 +1,18 @@
+package ui
+
+import (
+ "fmt"
+ "os"
+ "strings"
+ "time"
+ tea "charm.land/bubbletea/v2"
+)
+
+func diagnosticKeys(msg tea.Msg) {
+ f, err := os.OpenFile(os.Getenv("ASD_DIAGNOSTIC_KEYS"), os.O_WRONLY|os.O_CREATE|os.O_APPEND, 0600)
+ if err != nil { return }; defer f.Close()
+ kind := fmt.Sprintf("%T", msg)
+ fmt.Fprintf(f, "[DEBUG-asd-f6] %s %s", time.Now().UTC().Format(time.RFC3339Nano), kind)
+ if strings.Contains(kind, "Key") || strings.Contains(kind,"Unknown") { fmt.Fprintf(f, " %#v", msg) }
+ fmt.Fprintln(f)
+}
