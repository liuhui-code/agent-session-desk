{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASD Agent Recovery Declaration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "schema_version",
    "session_id",
    "run_id",
    "agent_id",
    "conversation_id",
    "resume"
  ],
  "properties": {
    "protocol": {
      "const": "asd.agent-recovery"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
      },
      "minLength": 32,
      "maxLength": 32
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
      },
      "minLength": 32,
      "maxLength": 32
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
      }
    },
    "agent_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
      }
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "args",
        "cwd"
      ],
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4096,
          "allOf": [
            {
              "pattern": "^[A-Za-z]:[\\\\/]"
            },
            {
              "not": {
                "pattern": "\\.(?:[cC][mM][dD]|[bB][aA][tT]|[pP][sS]1)$"
              }
            }
          ],
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
          }
        },
        "args": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 4096,
            "not": {
              "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
            }
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4096,
          "allOf": [
            {
              "pattern": "^[A-Za-z]:[\\\\/]"
            }
          ],
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
          }
        },
        "env": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
            "not": {
              "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
            }
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 0,
            "maxLength": 4096,
            "not": {
              "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
            }
          }
        }
      }
    }
  }
}
