{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASD Agent Recovery Result v1 (contract only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "schema_version",
    "session_id",
    "run_id",
    "attempt_id",
    "conversation_id",
    "status"
  ],
  "properties": {
    "protocol": {
      "const": "asd.agent-recovery-result"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
      },
      "minLength": 32,
      "maxLength": 32
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
      },
      "minLength": 32,
      "maxLength": 32
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
      },
      "minLength": 32,
      "maxLength": 32
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
      }
    },
    "status": {
      "enum": [
        "restored",
        "not_found",
        "failed"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 0,
      "maxLength": 512,
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
      }
    }
  }
}
